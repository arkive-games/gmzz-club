{
  "name": "gmzz-club",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "go run .",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "test": "go test ./...",
    "miniapp:install": "npm --prefix miniapp install",
    "miniapp:build": "npm --prefix miniapp run build:weapp",
    "miniapp:dev": "npm --prefix miniapp run dev:weapp"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.1"
  }
}
