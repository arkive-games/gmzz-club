upstream gmzz_club_api {
    server 127.0.0.1:19080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name gmzz-club-api.tc-imba.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name gmzz-club-api.tc-imba.com;

    ssl_certificate /etc/letsencrypt/live/gmzz-club-api.tc-imba.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gmzz-club-api.tc-imba.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;
    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://gmzz_club_api;
        proxy_read_timeout 120s;
    }

    location = / {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 404 '{"error":"API endpoint only"}';
    }

    location / {
        return 404;
    }
}
